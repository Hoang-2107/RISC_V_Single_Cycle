// ============================================================================
// rv32i_full.hex - Chuong trinh test DU 37 lenh RV32I (nap vao Instruction_Mem)
//   0x00-0x9C : giong rv32i_test.hex (lui, auipc, 6 nhanh, jal, jalr,
//               load/store byte-half-word, slti, andi, srai, xori)
//   0xA0-0xD4 : 10 lenh R-type + sltiu, ori, slli, srli
//   Ket thuc o PC = 0xD8 (jal x0, 0 -> nhay tai cho).
//   Moi lenh nhanh/nhay DUNG se bo qua "addi x31, x31, 1" -> cuoi cung x31 = 0.
//   Dung voi testbench: RISC.srcs/sim_1/new/tb_RV32I_full.v
// ============================================================================
ffb00093 // 0x00  addi  x1, x0, -5
00700113 // 0x04  addi  x2, x0, 7
123451b7 // 0x08  lui   x3, 0x12345
00001217 // 0x0C  auipc x4, 1
00209463 // 0x10  bne   x1, x2, +8      (nhay)
001f8f93 // 0x14  addi  x31, x31, 1     (bi bo qua)
0020c463 // 0x18  blt   x1, x2, +8      (nhay: -5 < 7)
001f8f93 // 0x1C  addi  x31, x31, 1
00115463 // 0x20  bge   x2, x1, +8      (nhay: 7 >= -5)
001f8f93 // 0x24  addi  x31, x31, 1
00116463 // 0x28  bltu  x2, x1, +8      (nhay: 7 < 0xFFFFFFFB)
001f8f93 // 0x2C  addi  x31, x31, 1
0020f463 // 0x30  bgeu  x1, x2, +8      (nhay)
001f8f93 // 0x34  addi  x31, x31, 1
00208a63 // 0x38  beq   x1, x2, bad1    (KHONG nhay)
00100293 // 0x3C  addi  x5, x0, 1
00109663 // 0x40  bne   x1, x1, bad1    (KHONG nhay)
00100313 // 0x44  addi  x6, x0, 1
008003ef // 0x48  jal   x7, +8          (x7 = 0x4C)
001f8f93 // 0x4C  bad1: addi x31, x31, 1
06000413 // 0x50  addi  x8, x0, 0x60
004404e7 // 0x54  jalr  x9, 4(x8)       (x9 = 0x58, nhay toi 0x64)
001f8f93 // 0x58  addi  x31, x31, 1
001f8f93 // 0x5C  addi  x31, x31, 1
001f8f93 // 0x60  addi  x31, x31, 1
04000513 // 0x64  addi  x10, x0, 0x40
808185b7 // 0x68  lui   x11, 0x80818
28358593 // 0x6C  addi  x11, x11, 0x283 (x11 = 0x80818283)
00b52023 // 0x70  sw    x11, 0(x10)
00050603 // 0x74  lb    x12, 0(x10)
00154683 // 0x78  lbu   x13, 1(x10)
00251703 // 0x7C  lh    x14, 2(x10)
00055783 // 0x80  lhu   x15, 0(x10)
002500a3 // 0x84  sb    x2, 1(x10)
00251123 // 0x88  sh    x2, 2(x10)
00052803 // 0x8C  lw    x16, 0(x10)
0000a893 // 0x90  slti  x17, x1, 0
0ff5f913 // 0x94  andi  x18, x11, 0xFF
4010d993 // 0x98  srai  x19, x1, 1
fff14a13 // 0x9C  xori  x20, x2, -1
00208ab3 // 0xA0  add   x21, x1, x2     (x21 = 00000002)
40110b33 // 0xA4  sub   x22, x2, x1     (x22 = 0000000C)
00211bb3 // 0xA8  sll   x23, x2, x2     (x23 = 00000380)
0020ac33 // 0xAC  slt   x24, x1, x2     (x24 = 00000001: -5 < 7)
0020bcb3 // 0xB0  sltu  x25, x1, x2     (x25 = 00000000: 0xFFFFFFFB > 7)
0020cd33 // 0xB4  xor   x26, x1, x2     (x26 = FFFFFFFC)
0025ddb3 // 0xB8  srl   x27, x11, x2    (x27 = 01010305)
4025de33 // 0xBC  sra   x28, x11, x2    (x28 = FF010305)
0020eeb3 // 0xC0  or    x29, x1, x2     (x29 = FFFFFFFF)
0020ff33 // 0xC4  and   x30, x1, x2     (x30 = 00000003)
0080b293 // 0xC8  sltiu x5, x1, 8       (x5  = 00000000)
0f016313 // 0xCC  ori   x6, x2, 0xF0    (x6  = 000000F7)
01c11413 // 0xD0  slli  x8, x2, 28      (x8  = 70000000)
01c0d513 // 0xD4  srli  x10, x1, 28     (x10 = 0000000F)
0000006f // 0xD8  halt: jal x0, 0
